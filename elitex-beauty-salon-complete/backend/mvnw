# -----------------------------------------------------------------------------
# Maven Start Up Batch script
#
# Required ENV vars:
# ------------------
#   JAVA_HOME - location of a JRE/JDK
#
# Optional ENV vars
# -----------------
#   MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#       set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
#   MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# -----------------------------------------------------------------------------

# Locate the wrapper script
script_path="${0}"
script_dir="$(cd "$(dirname "${script_path}")" && pwd)"

# Verify that the wrapper script is executable
if [ ! -x "${script_path}" ]; then
  echo "Error: Wrapper script '${script_path}' is not executable." >&2
  exit 1
fi

# Construct the path to the Maven wrapper JAR file
wrapper_jar_path="${script_dir}/.mvn/wrapper/maven-wrapper.jar"

# Verify that the Maven wrapper JAR file exists
if [ ! -f "${wrapper_jar_path}" ]; then
  echo "Error: Maven wrapper JAR file not found at '${wrapper_jar_path}'." >&2
  exit 1
fi

# Execute the Maven wrapper JAR file
exec "${JAVA_HOME}/bin/java" ${MAVEN_OPTS} -jar "${wrapper_jar_path}" "$@"
