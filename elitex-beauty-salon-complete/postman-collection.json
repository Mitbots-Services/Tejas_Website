{
	"info": {
		"_postman_id": "elitex-salon-full-test",
		"name": "EliteX Salon - Complete Integration Test",
		"description": "Comprehensive test suite for EliteX Beauty Salon Backend.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login Successful\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.not.be.null;",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usernameOrEmail\": \"admin\",\n    \"password\": \"admin123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost:8080/api/auth/login"
					}
				}
			]
		},
		{
			"name": "02. Public Content",
			"item": [
				{
					"name": "Get All Services",
					"request": {
						"method": "GET",
						"url": "http://localhost:8080/api/services"
					}
				},
				{
					"name": "Get Stylists",
					"request": {
						"method": "GET",
						"url": "http://localhost:8080/api/stylists"
					}
				}
			]
		},
		{
			"name": "03. Contact & Inquiries",
			"item": [
				{
					"name": "Submit Contact Form",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Customer\",\n    \"email\": \"john@gmail.com\",\n    \"message\": \"I want to book a bridal makeup session.\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost:8080/api/contact"
					}
				}
			]
		},
		{
			"name": "04. Booking System",
			"item": [
				{
					"name": "Book Appointment (Guest)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"serviceName\": \"Classic Haircut\",\n    \"stylistId\": 1,\n    \"appointmentDate\": \"2025-12-25\",\n    \"timeSlot\": \"11:00 AM\",\n    \"customerName\": \"Tejas Test\",\n    \"customerEmail\": \"tejas@test.com\",\n    \"customerPhone\": \"9876543210\",\n    \"notes\": \"Testing the new backend logic\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "http://localhost:8080/api/appointments/book"
					}
				}
			]
		},
		{
			"name": "05. Admin Panel (Secured)",
			"item": [
				{
					"name": "View All Appointments",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [ { "key": "token", "value": "{{jwt_token}}", "type": "string" } ]
						},
						"method": "GET",
						"url": "http://localhost:8080/api/appointments"
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "jwt_token", "value": "" }
	]
}